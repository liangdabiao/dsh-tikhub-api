{
  "name": "dsh-tikhub-api",
  "version": "0.1.0",
  "description": "TikHub API 助手：多平台社交媒体数据 API 的搜索、发现和调用技能。",
  "license": "MIT", "type": "module", "main": "src/host.js",
  "exports": { ".": "./src/host.js", "./client": "./dist/client.js", "./cordis.patch.yml": "./cordis.patch.yml", "./locale/*.json": "./locale/*.json", "./package.json": "./package.json" },
  "icon": "./icon.svg",
  "files": ["src", "dist", "lib", "skills", "locale/*.json", "cordis.patch.yml", "icon.svg", "README.md", "LICENSE"],
  "keywords": ["dsh-plugin", "deepseek-harness", "tikhub", "social-media"],
  "engines": { "node": "^22.19.0 || >=24.0.0", "dsh": ">=0.2.1-rc.2 <0.3.0" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "immediately": true, "inject": [] } },
  "devDependencies": { "esbuild": "^0.25.10" },
  "scripts": { "build": "node scripts/build.mjs", "test": "node test/lib.test.mjs", "prepack": "npm run build" }
}
